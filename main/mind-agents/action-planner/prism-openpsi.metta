; Optional PRISM control surface over the *real* PeTTa-OpenPSI rule space.
; Load this module only when PRISM is installed. Import action-planner-v2
; separately from the entrypoint: PeTTa resolves nested imports relative to
; the entrypoint, not relative to this module. Native planner remains intact.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file "prism/src/prism/adapters/openpsi/openpsi_ffi.pl" (prism-openpsi-best))

; The candidates are generated by OpenPsi's own applyCurrentActions.
; PRISM returns one of those exact pairs. If unavailable, native distance wins.
(= (PRISM.OpenPsi.Select $candidates $goal $ruleSpace $visited)
   (let $pick (prism-openpsi-best $candidates $goal (collapse (get-atoms $ruleSpace)) $visited)
        (if (== $pick Error)
            (let ($distance $nativePair)
                 (findMinDistance $candidates $goal 1000 () $ruleSpace)
                 $nativePair)
            $pick)))

; Bounded search control. OpenPsi owns legality, action application and rules;
; this wrapper only determines exploration order and prevents revisiting states.
(= (PRISM.OpenPsi.Plan $state $goal $ruleSpace $budget)
   (PRISM.OpenPsi.PlanStep $state $goal $ruleSpace $budget () ()))

(= (PRISM.OpenPsi.PlanStep $state $goal $ruleSpace $budget $visited $plan)
   (if (== $state $goal)
       (reverse $plan ())
       (if (<= $budget 0)
           ()
           (let* (($actions (getApplicableActions $state $ruleSpace))
                  ($candidates (applyCurrentActions $actions $state () $ruleSpace))
                  ($pick (PRISM.OpenPsi.Select $candidates $goal $ruleSpace $visited)))
                 (if (== $pick ())
                     ()
                     (let* (($action (car-atom $pick))
                            (($nextState) (cdr-atom $pick)))
                           (PRISM.OpenPsi.PlanStep $nextState $goal $ruleSpace
                                                   (- $budget 1)
                                                   (cons-atom $state $visited)
                                                   (cons-atom $action $plan))))))))
